# Application
APP_NAME=relivo-be-server
VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# RELOAD defaults to true in development/local/dev and false otherwise.
# RELOAD=true

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/relivo

# OpenAI
OPENAI_API_KEY=sk-your-key-here
RELIVO_CHAT_MODEL=gpt-5-mini
RELIVO_CHAT_REASONING_EFFORT=low
RELIVO_CHAT_USE_RESPONSES_API=true

# Long-term memory
MEMORY_RAG_MIN_SIMILARITY=0.75
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_TIMEOUT_SECONDS=1.5
MEMORY_EXTRACT_MODEL=gpt-5-mini
MEMORY_EXTRACT_REASONING_EFFORT=low

# Firecrawl MCP tools for agent web search/scrape/crawl/parse access
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_MCP_ENABLED=true
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp

# Clerk user sync
# Signing secret for POST /users/clerk/webhook. Copy from the Clerk dashboard →
# Webhooks → your endpoint → Signing Secret. Without it that route returns 503;
# the /users CRUD routes work regardless.
CLERK_WEBHOOK_SECRET=whsec_your-signing-secret

# User-registered custom MCP servers (remote URL only)
# Required to store credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RELIVO_MCP_SECRET_KEY=
RELIVO_MCP_MAX_SERVERS=20
RELIVO_MCP_MAX_TOOLS=64
# Runtime caches. Tools are refetched after the TTL; agent graphs are LRU-capped.
RELIVO_MCP_TOOL_CACHE_TTL=300
RELIVO_MCP_MAX_CACHED_AGENTS=32
# Local development only: allows http:// MCP URLs. Never enable in production.
# RELIVO_MCP_ALLOW_HTTP=false

# AWS S3 file storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=relivo.chat
AWS_S3_KEY_PREFIX=user-files
AWS_S3_MAX_UPLOAD_MB=25
AWS_S3_PRESIGNED_EXPIRES_SECONDS=3600
# Optional for S3-compatible providers/local testing.
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# Optional server-side encryption.
# AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
# AWS_S3_KMS_KEY_ID=
